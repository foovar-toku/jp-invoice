#!/usr/bin/env bash
# invoice.pij.systems のアクセス状況を集計する（宣伝の効果測定）。
#
#   bin/traffic          … 直近のアクセスログ全体
#   bin/traffic 7        … 直近7日分だけ
#
# 見るポイント:
#   - 見本 PDF / 導入事例の DL があるのに問い合わせが無い → 価格や導線の問題
#   - DL 自体が無い                                      → 流入の問題

set -euo pipefail

DAYS="${1:-0}"
LOG=/var/log/httpd/invoice_access.log

if [ "$DAYS" -gt 0 ]; then
  SINCE=$(date -d "-${DAYS} days" +%d/%b/%Y)
  FILTER="awk -v since=\"\$(date -d '-${DAYS} days' +%s)\" '{ gsub(/\\[/,\"\",\$4); split(\$4,a,\":\"); cmd=\"date -d \\\"\" a[1] \"\\\" +%s\"; cmd | getline t; close(cmd); if (t+0 >= since) print }'"
else
  FILTER="cat"
fi

# 相手側のログインシェルは zsh なので、glob 展開は sh に固定して渡す
ssh -o BatchMode=yes pij "sudo sh -c 'cat ${LOG}*' 2>/dev/null | ${FILTER}" > /tmp/invoice_access.$$ || true

total=$(wc -l < /tmp/invoice_access.$$)
printf '\n\033[1;4;36minvoice.pij.systems アクセス集計\033[0m  (%s 行)\n\n' "$total"

echo "== ページ別 =="
grep -oE '"GET [^ ?]+' /tmp/invoice_access.$$ | sed 's/"GET //' \
  | grep -vE '\.(css|png|ico|js)$' | sort | uniq -c | sort -rn | head -15

echo
echo "== PDF ダウンロード（見本・導入事例） =="
grep -oE '/(sample-invoice|case-study/[0-9a-z-]+)\.pdf' /tmp/invoice_access.$$ \
  | sort | uniq -c | sort -rn || echo "  まだ無し"

echo
echo "== 参照元（検索・SNS からの流入） =="
grep -oE '"https?://[^"]+"' /tmp/invoice_access.$$ | grep -v 'invoice.pij.systems' \
  | sed 's/"//g' | awk -F/ '{print $3}' | sort | uniq -c | sort -rn | head -10 || echo "  まだ無し"

echo
echo "== クローラ =="
grep -icE 'googlebot' /tmp/invoice_access.$$ | sed 's/^/  Googlebot: /'
grep -icE 'bingbot' /tmp/invoice_access.$$ | sed 's/^/  bingbot:   /'

rm -f /tmp/invoice_access.$$
